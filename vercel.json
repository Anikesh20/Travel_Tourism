{
    "version": 2,
    "builds": [
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        },
        {
            "src": "api/index.php",
            "use": "vercel-php@0.7.1"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "api/index.php"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}